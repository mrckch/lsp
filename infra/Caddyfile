# LSP – Caddyfile (Standard: hinter externem Reverse-Proxy, z. B. Nginx Proxy Manager)
#
# TLS terminiert der vorgeschaltete Proxy; Caddy spricht nur HTTP auf :80.
# Für den Betrieb OHNE externen Proxy (Caddy holt selbst Let's-Encrypt-Zertifikate):
#   LSP_CADDYFILE=Caddyfile.tls in der .env setzen.

{
    auto_https off

    servers {
        # X-Forwarded-For/-Proto nur von diesen Absendern übernehmen
        # (LSP_CADDY_TRUSTED_PROXIES in der .env, z. B. die IP der NPM-VM).
        trusted_proxies static {$LSP_TRUSTED_PROXIES:private_ranges}
    }
}

:80 {
    # Achtung: Pfad muss zwischen Caddy und PHP-FPM identisch sein, weil
    # Caddys php_fastcgi standardmäßig SCRIPT_FILENAME=$root/index.php
    # an PHP-FPM weitergibt. Im app-Container liegt public/ unter
    # /var/www/html/public — daher hier denselben Pfad nutzen.
    root * /var/www/html/public
    encode zstd gzip

    # Security headers (HSTS wirkt, weil der Browser über den https-Proxy zugreift)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        -Server
    }

    # Statische Dateien direkt liefern, sonst an PHP-FPM
    @notfile {
        not file
    }
    rewrite @notfile /index.php

    php_fastcgi app:9000
    file_server

    log {
        output stdout
        format json
    }
}
