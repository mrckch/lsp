# LSP – Caddyfile
# In Produktion via Umgebungsvariable LSP_HOSTNAME setzen.

{
    # Globale Optionen
    email {$LETSENCRYPT_EMAIL:admin@example.com}
    # Lokal/Dev: kein automatischer HTTP→HTTPS-Redirect, weil
    # auf der Host-Maschine evtl. ein anderer Service auf 443 lauscht.
    # In Produktion (mit echter Domain via LSP_HOSTNAME) entfernen!
    auto_https disable_redirects
}

http://{$LSP_HOSTNAME:localhost}, {$LSP_HOSTNAME:localhost} {
    # Achtung: Pfad muss zwischen Caddy und PHP-FPM identisch sein, weil
    # Caddys php_fastcgi standardmäßig SCRIPT_FILENAME=$root/index.php
    # an PHP-FPM weitergibt. Im app-Container liegt public/ unter
    # /var/www/html/public — daher hier denselben Pfad nutzen.
    root * /var/www/html/public
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        -Server
    }

    # Statische Dateien direkt liefern, sonst an PHP-FPM
    @notfile {
        not file
    }
    rewrite @notfile /index.php

    php_fastcgi app:9000
    file_server

    log {
        output stdout
        format json
    }
}
