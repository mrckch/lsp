APP_NAME="LSP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lsp
DB_USERNAME=lsp
DB_PASSWORD=lsp_dev
DB_ROOT_PASSWORD=lsp_root_dev

# Cache / Queue / Session via Redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null

# Caddy / Reverse Proxy
LSP_HOSTNAME=localhost
LSP_HTTP_PORT=8080
LSP_HTTPS_PORT=8443
LETSENCRYPT_EMAIL=admin@example.com

# Mail (Phase 4)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="lsp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gotenberg (PDF)
GOTENBERG_URL=http://pdf:3000

# LSP-spezifisch
LSP_AUTO_MIGRATE=false
LSP_2FA_REAUTH_TTL_MINUTES=15
LSP_RECOVERY_KEY_LENGTH=32
LSP_DEFAULT_TIME_LIMIT_SECONDS=180
LSP_DEFAULT_PRACTICE_SECONDS=30
