{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lsp/lese-screening-portal",
    "type": "project",
    "description": "LSP – Lese-Screening-Portal: Open-Source-Webanwendung für digitale Lesediagnostik an Schulen.",
    "keywords": ["laravel", "schule", "lesescreening", "sls", "diagnostik", "education"],
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.0",
        "dedoc/scramble": "^0.12",
        "filament/filament": "^3.2",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "league/flysystem-sftp-v3": "^3.29",
        "maatwebsite/excel": "^3.1",
        "pragmarx/google2fa-laravel": "^2.3",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-permission": "^6.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/dusk": "^8.6",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
