# LSP – Produktions-Konfiguration (Vorlage für Betrieb hinter Nginx Proxy Manager)
#
#   cp .env.production.example .env
#   → alle <…>-Platzhalter ersetzen, dann siehe DEPLOYMENT.md

APP_NAME="LSP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<lsp.deine-schule.de>
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lsp
DB_USERNAME=lsp
DB_PASSWORD=<langes-zufalls-passwort>
DB_ROOT_PASSWORD=<anderes-langes-zufalls-passwort>

# Cache / Queue / Session via Redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=<langes-zufalls-passwort>

# --- Reverse Proxy: Nginx Proxy Manager auf eigener VM ---
# Caddy spricht nur HTTP; TLS macht NPM.
LSP_CADDYFILE=Caddyfile
# IP der LSP-VM, auf der Caddy lauscht (0.0.0.0 = alle Interfaces).
# Den Port per Firewall nur für die NPM-VM freigeben!
LSP_HTTP_BIND=0.0.0.0
LSP_HTTP_PORT=8080
LSP_HTTPS_PORT=8443
# Caddy übernimmt X-Forwarded-* nur von der NPM-VM
LSP_CADDY_TRUSTED_PROXIES=<ip-der-npm-vm>/32
# Laravel vertraut den Forward-Headern (echte Schüler-IP, https-Schema).
# '*' ist ok, weil nur Caddy (intern) PHP-FPM erreicht und Caddy fremde Header verwirft.
TRUSTED_PROXIES=*
LSP_HOSTNAME=<lsp.deine-schule.de>
LETSENCRYPT_EMAIL=<admin@deine-schule.de>

# Mail
MAIL_MAILER=smtp
MAIL_HOST=<smtp.deine-schule.de>
MAIL_PORT=587
MAIL_USERNAME=<lsp@deine-schule.de>
MAIL_PASSWORD=<smtp-passwort>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="<lsp@deine-schule.de>"
MAIL_FROM_NAME="${APP_NAME}"

# Gotenberg (PDF)
GOTENBERG_URL=http://pdf:3000

# LSP-spezifisch
LSP_AUTO_MIGRATE=false
LSP_2FA_REAUTH_TTL_MINUTES=15
LSP_RECOVERY_KEY_LENGTH=32
LSP_DEFAULT_TIME_LIMIT_SECONDS=180
LSP_DEFAULT_PRACTICE_SECONDS=30
LSP_BACKUP_TIME=02:30
LSP_AUDIT_ARCHIVE_AFTER_DAYS=90
LSP_AUDIT_PURGE_AFTER_DAYS=730

# Schüler-Rate-Limits (pro Minute). Ganze Klassen teilen sich eine Schul-IP.
LSP_STUDENT_LOGIN_PER_IP=300
LSP_STUDENT_LOGIN_PER_CODE=10
LSP_STUDENT_ANSWERS_PER_ATTEMPT=120
